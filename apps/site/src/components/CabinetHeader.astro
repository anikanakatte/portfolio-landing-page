---
import { DRAWERS } from '../lib/site';
---
<header class="cab">
  <div class="wrap">
    <a class="mark" href="/" aria-label="anirudh.dev home">anirudh<span>.dev</span></a>
    <nav aria-label="Sections">
      <ul class="drawers">
        {DRAWERS.map((d) => (
          <li>
            <a href={`/#${d.id}`}>
              <span class="dd">{d.dewey}</span>
              <span class="nm">{d.name}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <button id="theme-toggle" class="toggle" type="button" aria-pressed="false" aria-label="Switch theme" hidden>
      <svg class="sun" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <circle cx="12" cy="12" r="4.2" />
        <path d="M12 2.5v2.4M12 19.1v2.4M2.5 12h2.4M19.1 12h2.4M5.3 5.3l1.7 1.7M17 17l1.7 1.7M5.3 18.7 7 17M17 7l1.7-1.7" />
      </svg>
      <svg class="moon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M20.2 14.6A8.3 8.3 0 0 1 9.4 3.8a8.3 8.3 0 1 0 10.8 10.8Z" />
      </svg>
    </button>
  </div>
</header>

<style>
  .cab {
    background: var(--cabinet); color: var(--on-cabinet);
    position: sticky; top: 0; z-index: 5;
    padding-top: env(safe-area-inset-top, 0px);
    border-bottom: 3px solid var(--cabinet-2);
  }
  .wrap { display: flex; align-items: center; gap: 24px; padding-block: 12px; }
  .mark { font: 400 1.35rem/1 var(--f-display); text-decoration: none; white-space: nowrap; }
  .mark span { color: var(--brass-hi); }
  nav { margin-left: auto; min-width: 0; }
  /* overflow-x: auto also clips vertically. Give the hover lift (1px) and the focus
     ring (3px offset + 2px outline) 6px of room on every side, and cancel it out with
     a negative margin so the layout doesn't move. */
  .drawers {
    display: flex; gap: 8px; list-style: none;
    padding: 6px; margin: -6px;
    overflow-x: auto; scrollbar-width: none;
  }
  .drawers::-webkit-scrollbar { display: none; }
  .drawers a, .toggle {
    border: 1.5px solid var(--brass); border-radius: 3px;
    background: linear-gradient(var(--cabinet-2), var(--cabinet));
    transition: border-color .15s, transform .15s;
  }
  .drawers a {
    display: flex; flex-direction: column; align-items: center; text-decoration: none;
    padding: 5px 12px 6px; min-width: 84px;
  }
  .drawers a:hover, .toggle:hover { border-color: var(--brass-hi); transform: translateY(-1px); }
  .dd { font: 700 .68rem/1 var(--f-type); color: var(--brass-hi); letter-spacing: .06em; }
  .nm { font: 500 .82rem/1.3 var(--f-ui); }

  .toggle {
    flex: none; display: inline-grid; place-items: center; width: 40px; height: 40px; padding: 0;
    color: var(--brass-hi); cursor: pointer;
  }
  .toggle svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; }
  .toggle .sun circle { fill: currentColor; stroke: none; }
  .toggle .moon path { fill: currentColor; stroke: none; }
  /* Show the icon for the theme you'd switch TO. */
  .toggle .sun { display: none; }
  :global(:root[data-theme='dark']) .toggle .sun { display: block; }
  :global(:root[data-theme='dark']) .toggle .moon { display: none; }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .toggle .sun { display: block; }
    :global(:root:not([data-theme='light'])) .toggle .moon { display: none; }
  }

  @media (max-width: 640px) {
    .wrap { flex-wrap: wrap; gap: 10px 12px; padding-block: 10px 8px; }
    .mark { flex: 1; }
    .toggle { width: 36px; height: 36px; order: 2; }
    nav { order: 3; flex-basis: 100%; margin-left: 0; }
    .drawers a { min-width: 74px; padding: 4px 10px 5px; }
  }
</style>
