---
import { getCollection } from 'astro:content';
import IndexCard from './IndexCard.astro';
import SectionHead from './SectionHead.astro';
import { SITE } from '../lib/site';

// Most recent first: current roles ("Now") on top, then by end year, then start year.
const year = (s: string) => (s === 'Now' ? 9999 : Number(s.match(/\d{4}/)?.[0] ?? 0));
const jobs = (await getCollection('work')).sort(
  (a, b) => year(b.data.end) - year(a.data.end) || year(b.data.start) - year(a.data.start),
);
// Alternate stamp angles so it looks hand-stamped.
const tilt = ['-3deg', '2deg', '-1deg', '1.5deg'];
---
<section id="work" aria-labelledby="work-title">
  <div class="wrap">
    <SectionHead dewey="331.7" title="Work history" id="work-title">
      Stamped like the date-due slip in a library book. Most recent on top.
    </SectionHead>

    <div class="slip-wrap">
      <IndexCard as="div" class="slip">
        <div class="title" aria-hidden="true">DATE DUE · BORROWED BY</div>
        <table>
          <thead>
            <tr><th scope="col">Dates</th><th scope="col">Role</th></tr>
          </thead>
          <tbody>
            {jobs.map(({ data }, i) => (
              <tr>
                <td>
                  <span class="stamp" style={`--r:${tilt[i % tilt.length]}`}>
                    {data.start} — {data.end}
                  </span>
                </td>
                <td>
                  <div class="role">{data.role} · {data.org}</div>
                  <ul class="what">
                    {data.bullets.map((b) => <li>{b}</li>)}
                  </ul>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </IndexCard>
      <a class="btn resume" href={SITE.resumePath} target="_blank" rel="noopener noreferrer">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M7 3h7l5 5v13H7zM14 3v5h5M10 13h6M10 17h6" /></svg>
        View full résumé <span class="fmt">(PDF)</span> ↗
      </a>
    </div>
  </div>
</section>

<style>
  section { padding-block: 56px; }
  .slip-wrap { max-width: 820px; }
  .slip { padding: 0 0 30px; overflow: hidden; background-image: none; }
  .title {
    background: var(--cabinet); color: var(--on-cabinet); font: 700 .82rem/1 var(--f-type);
    letter-spacing: .2em; text-align: center; padding: 12px;
  }
  table { width: 100%; border-collapse: collapse; font-family: var(--f-type); }
  th {
    font: 700 .72rem/1 var(--f-type); letter-spacing: .14em; text-transform: uppercase;
    color: var(--card-muted); text-align: left; padding: 12px 18px; border-bottom: 1.5px solid var(--rule-red);
  }
  td { padding: 16px 18px; border-bottom: 1px solid var(--rule-blue); vertical-align: top; font-size: .92rem; }
  /* Dates column shrinks to fit its stamp (width: 1% + nowrap) instead of a fixed width. */
  td:first-child { width: 1%; white-space: nowrap; border-right: 1px solid var(--rule-red); }
  .role { font-weight: 700; }
  .what { color: var(--card-muted); margin: 6px 0 0; padding: 0; list-style: none; display: grid; gap: 6px; line-height: 1.5; }
  /* Dash drawn with ::before: ::marker colours render inconsistently across browsers. */
  .what li { position: relative; padding-left: 1.3em; }
  .what li::before { content: '–'; position: absolute; left: 0; color: var(--rule-red); }
  .resume { margin-top: 22px; }
  .resume svg { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .fmt { font-weight: 400; opacity: .75; }
  .stamp { transform: rotate(var(--r, -3deg)); font-size: .78rem; white-space: nowrap; }
  /* Phones: stack each row (date stamp above the role) so the role and bullets get the full
     card width. The column headings are redundant once stacked. */
  @media (max-width: 640px) {
    section { padding-block: 40px; }
    thead { display: none; }
    table, tbody, tr, td { display: block; width: 100%; }
    tr { padding: 16px 16px 18px; border-bottom: 1px solid var(--rule-blue); }
    tr:first-child { border-top: 1.5px solid var(--rule-red); }
    td { padding: 0; border: 0; font-size: .95rem; }
    td:first-child { width: auto; border-right: 0; margin-bottom: 12px; }
    .what { gap: 8px; line-height: 1.55; }
  }
</style>
